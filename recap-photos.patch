diff --git a/zminutes-v2.css b/zminutes-v2.css
index 7034b48..f96fe88 100644
--- a/zminutes-v2.css
+++ b/zminutes-v2.css
@@ -553,3 +553,20 @@ textarea {
 .transcript-actions.transcript-translate .translation-target { flex: 1 1 120px; min-width: 0; }
 .transcript-actions.transcript-translate > #translateTranscriptBtn { flex: 0 0 auto; }
 .transcript-actions > .secondary { white-space: nowrap; padding-left: 10px; padding-right: 10px; }
+
+/* recap photos (screen + print) */
+.recap-photos-title { margin: 18px 0 8px; font-weight: 700; }
+.recap-photos { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 10px; }
+.recap-photos figure { margin: 0; }
+.recap-photos img { display: block; width: 100%; max-height: 260px; object-fit: cover; border-radius: 10px; border: 1px solid var(--line); }
+.recap-photos figcaption { margin-top: 4px; font-size: 12px; color: var(--muted); }
+@media print {
+  .print-document .print-rich p, .print-document .print-rich li { white-space: normal; }
+  .print-document .print-rich ul, .print-document .print-rich ol { margin: 4pt 0 8pt; padding-left: 18pt; }
+  .print-document .print-rich h3 { font-size: 12.5pt; margin: 10pt 0 4pt; break-after: avoid; }
+  .print-document .print-rich hr { border: 0; border-top: 1px solid #999; margin: 8pt 0; }
+  .print-document .print-photos { display: grid; grid-template-columns: 1fr 1fr; gap: 8pt; }
+  .print-document figure { margin: 0; break-inside: avoid; }
+  .print-document figure img { width: 100%; max-height: 90mm; object-fit: contain; }
+  .print-document figcaption { font-size: 9pt; color: #444; }
+}
